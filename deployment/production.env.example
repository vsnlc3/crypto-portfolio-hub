# Copy to a Git-ignored .env.production file on the deployment host, replace placeholders,
# and restrict the file to the deployment user (for example, mode 600).
# APP_DOMAIN must be the bare hostname registered in DNS, without a scheme or path.
APP_DOMAIN=portfolio.example.com

POSTGRES_DB=crypto_portfolio_hub
POSTGRES_USER=crypto_portfolio_hub
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET

# Supply a protected, Base64-encoded 32-byte key. Do not commit or bake it into an image.
CREDENTIAL_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Optional provider keys; omit or leave blank until configured.
COINGECKO_DEMO_API_KEY=
EXCHANGERATE_API_KEY=
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
