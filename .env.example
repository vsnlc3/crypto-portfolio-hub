# Copy this file to .env and replace the placeholder with a local development password.
POSTGRES_DB=crypto_portfolio_hub
POSTGRES_USER=crypto_portfolio_hub
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Google OAuth is disabled until a local OAuth client is configured.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_COOKIE_SECURE=false
