# Copy this file to .env and replace the placeholder with a local development password.
POSTGRES_DB=crypto_portfolio_hub
POSTGRES_USER=crypto_portfolio_hub
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Google OAuth is disabled until a local OAuth client is configured.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SESSION_COOKIE_SECURE=false

# Optional until a Provider credential is stored. Generate locally with: openssl rand -base64 32
# Keep this Base64-encoded 32-byte AES-256 key out of Git and Docker images.
CREDENTIAL_ENCRYPTION_KEY_BASE64=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Local OAuth callback is handled by Backend on localhost:8080; login returns to the Frontend.
BACKEND_HOST_PORT=8080
FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_OAUTH_AUTHORIZATION_URL=http://localhost:8080/oauth2/authorization/google
